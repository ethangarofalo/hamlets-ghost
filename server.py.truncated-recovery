def _hash_prompt(text):
    return hashlib.sha256(text.encode()).hexdigest()[:12]


def _get_admin_api_token():
    return os.getenv("LAB_ADMIN_TOKEN") or os.getenv("ADMIN_API_TOKEN")


def _require_admin_token(provided_token):
