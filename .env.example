# Hamlet's Ghost local configuration template.
# Copy to .env for local runs. Never commit real .env files.

# Required for default model-backed experiments using the OpenAI backend.
# Apollo does not use this key when APOLLO_BACKEND=hermes_cli; in that mode it calls APOLLO_HERMES_BIN.
OPENAI_API_KEY=replace_me

# Required for write endpoints in the local dashboard/API.
# Generate a long random value before running anything writable.
LAB_ADMIN_TOKEN=replace_with_a_long_random_admin_token
ADMIN_API_TOKEN=

# Server.
LAB_HOST=127.0.0.1
PORT=7777
LAB_DB_PATH=

# Model request behavior.
MODEL_REQUEST_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=1.5

# Epoch labels.
LAB_CURRENT_EPOCH=native_cast
LAB_LEGACY_EPOCH=legacy_foundation
LAB_JUDGE_PANEL_VERSION=muse_athena_apollo_v1_independent
LAB_ASSEMBLING_STALE_MINUTES=20

# Default OpenAI models.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_HOLDOUT_MODEL=gpt-4.1-mini

# Generator and evaluator roles.
GENESIS_BACKEND=openai
GENESIS_MODEL=gpt-4.1-mini
GENESIS_PROTOCOL=socratic
GENESIS_BRANCH_MODEL=

MUSE_BACKEND=openai
MUSE_MODEL=gpt-4.1-mini

ATHENA_BACKEND=openai
ATHENA_MODEL=gpt-4.1-mini
ATHENA_GATE_ENABLED=1
ATHENA_MIN_MUSE_COMPOSITE=7.5
ATHENA_REQUIRE_CONSTRAINT_PASS=1

COUNCIL_BACKEND=openai
COUNCIL_MODEL=gpt-4.1-mini

# Legacy aliases still supported.
HERMES_BACKEND=openai
HERMES_MODEL=gpt-4.1-mini
HERMES_GATE_ENABLED=1
HERMES_MIN_MUSE_COMPOSITE=7.5
HERMES_REQUIRE_CONSTRAINT_PASS=1
HERMES_EXTERNAL_BACKEND=
HERMES_EXTERNAL_MODEL=gpt-5.4
HOLDOUT_BACKEND=openai
HOLDOUT_MODEL=gpt-4.1-mini

# Optional local/OpenAI-compatible backends.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

OPENCLAW_BASE_URL=http://127.0.0.1:8000/v1
OPENCLAW_API_KEY=openclaw
OPENCLAW_BIN=openclaw
OPENCLAW_MODEL=openclaw/latest

GENESIS_OPENCLAW_BACKEND=openclaw
GENESIS_OPENCLAW_MODEL=openclaw/latest
GENESIS_OPENCLAW_FAMILIES=
SCOUT_GATE_ENABLED=0

# Apollo external evaluator lane.
APOLLO_BACKEND=hermes_cli
APOLLO_MODEL=gpt-5.4
APOLLO_HERMES_BIN=hermes
APOLLO_HERMES_PROVIDER=auto

# Theron external generator lane.
THERON_BACKEND=openclaw_local
THERON_MODEL=anthropic/claude-opus-4-7
THERON_OPENCLAW_AGENT_ID=main
THERON_OPENCLAW_BIN=openclaw
THERON_BASE_URL=http://127.0.0.1:8010/v1
THERON_API_KEY=openclaw
THERON_HEALTH_URL=http://127.0.0.1:8010/health

# Optional Theron gateway.
THERON_GATEWAY_HOST=127.0.0.1
THERON_GATEWAY_PORT=8010
THERON_GATEWAY_MODE=mock
THERON_GATEWAY_MODEL=theron-gateway
THERON_BOT_NAME=Theron
THERON_TELEGRAM_API_ID=
THERON_TELEGRAM_API_HASH=
THERON_TELEGRAM_SESSION_STRING=
THERON_TELEGRAM_SESSION_FILE=
THERON_TELEGRAM_TIMEOUT_SECONDS=90

# Optional human-review relay.
HUMAN_REVIEW_CHANNEL=local
HUMAN_REVIEW_TARGET=

# Optional interlocutor role.
INTERLOCUTOR_BACKEND=openai
INTERLOCUTOR_MODEL=gpt-4.1-mini

# Deterministic testing/debug knobs. Leave blank for normal use.
FORCED_ATHENA_CONSTRAINT_FAIL_MODULO=
FORCED_ATHENA_UNKNOWN_CONSTRAINT_MODULO=
FORCED_ATHENA_LOW_SCORE_MODULO=
