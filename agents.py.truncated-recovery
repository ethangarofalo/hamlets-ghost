def _is_retryable_model_error(exc):
    if isinstance(exc, (TimeoutError, OSError)):
        return True
    message = str(exc).lower()
    retry_markers = (
        "timeout",
        "timed out",
        "tempor",
        "rate limit",
        "overloaded",
        "connection reset",
        "connection aborted",
        "connection refused",
        "server error",
        "service unavailable",
        "transient",
    )
    return any(marker in message for marker in retry_markers)


