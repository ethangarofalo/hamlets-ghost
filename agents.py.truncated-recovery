def _parse_json_response(text):
    """Parse JSON from model response, handling markdown fences. Returns (parsed_dict, was_parse_failure)."""
    text = (text or "").strip()
    if text.startswith("```"):
        text = text.split("\n", 1)[1].rsplit("```", 1)[0].strip()

    candidates = [text]
    start_positions = [idx for idx, ch in enumerate(text) if ch in "{["]
    for start in start_positions:
        stack = []
        for idx in range(start, len(text)):
            ch = text[idx]
            if ch in "{[":
                stack.append("}" if ch == "{" else "]")
            elif ch in "}]":
                if not stack or ch != stack[-1]:
                    break
                stack.pop()
                if not stack:
                    candidates.append(text[start:idx + 1].strip())
                    break
    try:
        for candidate in candidates:
            try:
                return json.loads(candidate), False
            except json.JSONDecodeError:
                continue
        return None, True
    except Exception:
        return None, True


async def _generate_json_with_retry(role, system, user_content, max_tokens=*** retry_instruction=None):
    text, response = await _generate_text(
        role=role,
        system=system,
        user_content=user_content,
        max_tokens=***
    )
    result, parse_failure = _parse_json_response(text)
    if not parse_failure:
        return result, response, False

    retry_content = user_content
    if retry_instruction:
        retry_content = f"{user_content}\n\n{retry_instruction}"
    else:
        retry_content = f"{user_content}\n\nReturn ONLY valid JSON matching the required schema."

    retry_text, retry_response = await _generate_text(
        role=role,
        system=system,
        user_content=retry_content,
        max_tokens=***
    )
    retry_result, retry_parse_failure = _parse_json_response(retry_text)
    return retry_result, retry_response, retry_parse_failure


def _get_client(backend):
    if backend == "openai":
        if not OPENAI_API_KEY:
            raise RuntimeError("OPENAI_API_KEY is not set. Add it to your environment or .env before running experiments.")
        return OPENAI_CLIENT
    if backend == "ollama":
        return OLLAMA_CLIENT
    raise RuntimeError(f"Unsupported backend '{backend}'. Use 'openai' or 'ollama'.")


